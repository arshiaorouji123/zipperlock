# Copy to .env.local and fill in, then run `npm run build`.
# Every value is optional — leave blank to disable that feature.

# Public URL of the site (used for sitemap, canonical URLs, structured data)
NEXT_PUBLIC_SITE_URL=https://zipperlock.net

# Contact address shown on Contact / Privacy / Terms pages
NEXT_PUBLIC_CONTACT_EMAIL=hello@zipperlock.net

# Set to 1 when hosting on PHP (cPanel) to enable the contact form (public/contact.php)
NEXT_PUBLIC_PHP_CONTACT=

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX (loads only after cookie consent)
NEXT_PUBLIC_GA_ID=

# Google Search Console HTML-tag verification code (content="..." value only)
NEXT_PUBLIC_GSC_VERIFICATION=

# Google AdSense publisher ID, e.g. ca-pub-1234567890123456 (loads only after cookie consent)
NEXT_PUBLIC_ADSENSE_CLIENT=
# Ad unit slot IDs
NEXT_PUBLIC_ADSENSE_SLOT_HOME=
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE=
